@{
    ViewBag.Title = "Cost Rollup";
}
@section Styles {
    <style>
        #costRollupPage { max-width: 1440px; }
        #costRollupPage .cr-note { color: #515c6b; margin: 8px 0 16px; }
        #costRollupPage .cr-toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; margin-bottom: 16px; }
        #costRollupPage .cr-field { display: flex; flex-direction: column; gap: 4px; }
        #costRollupPage .cr-field label { margin: 0; }
        #costRollupPage input, #costRollupPage select { min-height: 34px; }
        #costRollupPage .cr-table-wrap { overflow-x: auto; }
        #costRollupPage table { width: 100%; }
        #costRollupPage th, #costRollupPage td { padding: 9px 10px; vertical-align: top; }
        #costRollupPage th { background: #f1f4f7; white-space: nowrap; }
        #costRollupPage td { word-break: break-word; max-width: 260px; }
        #costRollupPage .cr-date { white-space: nowrap; }
        #costRollupPage .cr-editor { border: 1px solid #c8d1db; border-radius: 4px; padding: 18px; margin: 20px 0; background: #f8fafc; }
        #costRollupPage .cr-message { padding: 10px 12px; margin: 12px 0; border-left: 4px solid #276f43; background: #edf6ef; }
        #costRollupPage .cr-error { border-left-color: #a52626; background: #fff0f0; color: #8d1f1f; }
        #costRollupPage [hidden] { display: none !important; }
    </style>
}
<div id="costRollupPage" data-search-url="@Url.Action("Search", "CostRollup")"
     data-add-url="@Url.Action("Add", "CostRollup")" data-update-url="@Url.Action("Update", "CostRollup")"
     data-delete-url="@Url.Action("Delete", "CostRollup")">
    <h4>Cost Rollup</h4>
    <p class="cr-note">จัดการ hold ตาม Customer การเพิ่ม แก้ไข และลบมีผลเมื่อ service เริ่มรอบถัดไป</p>
    <div id="crMessage" class="cr-message" role="status" aria-live="polite" hidden></div>
    <form id="crSearchForm">
        <fieldset id="crSearchFields" class="cr-toolbar">
            <div class="cr-field">
                <label for="crSearchCustomer">Customer</label>
                <input id="crSearchCustomer" class="form-control form-control-sm" maxlength="2" placeholder="เช่น 0C" autocomplete="off" />
            </div>
            <div class="cr-field">
                <label for="crSearchStatus">Status</label>
                <select id="crSearchStatus" class="form-control form-control-sm"><option value="">ทั้งหมด</option><option value="Y">Y</option><option value="N">N</option></select>
            </div>
            <button class="btn btn-primary btn-sm" type="submit">ค้นหา / โหลดใหม่</button>
            <button id="crAdd" class="btn btn-success btn-sm" type="button">เพิ่ม Customer</button>
        </fieldset>
    </form>
    <form id="crEditor" class="cr-editor" hidden>
        @Html.AntiForgeryToken()
        <h5 id="crEditorTitle">เพิ่ม Customer</h5>
        <fieldset id="crEditFields">
            <div class="cr-toolbar">
                <div class="cr-field">
                    <label for="crCustomer">Customer</label>
                    <input id="crCustomer" class="form-control form-control-sm" maxlength="2" pattern="[A-Za-z0-9]{2}" required autocomplete="off" />
                </div>
                <div class="cr-field">
                    <label for="crStatus">Status</label>
                    <select id="crStatus" class="form-control form-control-sm"><option value="Y">Y</option><option value="N">N</option></select>
                </div>
                <div class="cr-field">
                    <label for="crFrom">From</label>
                    <input id="crFrom" class="form-control form-control-sm" type="datetime-local" step="1" min="0001-01-01T00:00:00" max="9999-12-31T23:59:59" />
                </div>
                <div class="cr-field">
                    <label for="crTo">To</label>
                    <input id="crTo" class="form-control form-control-sm" type="datetime-local" step="1" min="0001-01-01T00:00:00" max="9999-12-31T23:59:59" />
                </div>
            </div>
            <p class="cr-note">From และ To ใช้เวลาของ Oracle server กรอกให้ครบทั้งคู่ หรือเว้นว่างทั้งคู่เพื่อ hold ไม่มีกำหนดเมื่อ Status เป็น Y<br />ช่วงวันที่รวมเวลาเริ่มและสิ้นสุด หาก From ยังมาไม่ถึง service จะยังไม่ hold การแก้ไขจะล้าง Slip reference และใช้รหัสผู้ใช้ที่เข้าสู่ระบบ</p>
            <button class="btn btn-primary btn-sm" type="submit">บันทึก</button>
            <button id="crDelete" class="btn btn-danger btn-sm" type="button" hidden>ลบ Customer นี้</button>
            <button id="crCancel" class="btn btn-secondary btn-sm" type="button">ยกเลิก</button>
        </fieldset>
    </form>
    <p id="crCount" role="status" aria-live="polite">กำลังโหลดข้อมูล</p>
    <div class="cr-table-wrap">
        <table class="table table-sm table-bordered" aria-label="รายการ Cost Rollup">
            <thead><tr><th scope="col">Customer</th><th scope="col">Status</th><th scope="col">Slip reference</th><th scope="col">Change by</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Last update</th><th scope="col">จัดการ</th></tr></thead>
            <tbody id="crRows"></tbody>
        </table>
    </div>
</div>
@section scripts {
    <script src="~/Scripts/Views/CostRollup.js"></script>
}
