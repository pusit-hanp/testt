<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Replace xxx on the target server with SAME-environment values. Never commit a real password. -->
    <add name="Material" connectionString="User Id=MATERIAL;Password=xxx;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=xxx)(PORT=1521))(CONNECT_DATA=(SID=xxx)));" />
  </connectionStrings>
  <appSettings>
    <!-- Set the actual UNC path. Do not use the interactive user's mapped R: drive. -->
    <add key="HvpFilePath" value="" />
    <add key="TimerIntervalMinutes" value="5" />
    <!-- Total failed attempts per file version, including the first attempt. -->
    <add key="MaxFileAttempts" value="3" />
    <!-- Delete only service daily logs older than this many days; 0 disables cleanup. -->
    <add key="LogRetentionDays" value="30" />
    <!-- Empty uses %ProgramData%\Z02JHVPService; grant the service account Modify here. -->
    <add key="HvpStatePath" value="" />
  </appSettings>
  <!-- Assembly binding redirects are generated by the project into the output EXE.config. -->
</configuration>
