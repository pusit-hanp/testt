<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Set the actual UNC path. Do not use the interactive user's mapped R: drive. -->
    <add key="HvpFilePath" value="" />
    <add key="TimerIntervalMinutes" value="5" />
    <!-- Total failed attempts per file version, including the first attempt. -->
    <add key="MaxFileAttempts" value="3" />
    <!-- Delete only service daily logs older than this many days; 0 disables cleanup. -->
    <add key="LogRetentionDays" value="30" />
    <!-- Empty uses %ProgramData%\Z02JHVPService; grant the service account Modify here. -->
    <add key="HvpStatePath" value="" />
    <!-- Copy the required DecryptCTN or Encs_T setting from the approved SAME-environment configuration.
         Secret values are intentionally not supplied in this reference package. -->
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
