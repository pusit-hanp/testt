@{
    ViewBag.Title = "Report and Repost";
}
@section Styles {
    <link href="~/Scripts/bootstrap-datepicker/css/bootstrap-datepicker3.min.css" rel="stylesheet" />
    <style>
        #dt_ReportRepost td { vertical-align: middle; white-space: nowrap; }
        #dt_ReportRepost th { white-space: nowrap; }
        #dt_ReportRepost td.status-text { white-space: normal; min-width: 240px; word-break: break-word; }
        #dt_ReportRepost td.select-cell, #dt_ReportRepost td.reason-text { white-space: normal; min-width: 160px; word-break: break-word; }
        #reportTableArea.is-busy { pointer-events: none; opacity: .65; }
        #repostResults td { white-space: pre-wrap; word-break: break-word; }
    </style>
}
<h5><u>Report and Repost</u></h5>
<form id="formReportRepost">
    @Html.AntiForgeryToken()
    <fieldset id="searchFields">
        <div class="form-group row">
            <label for="s_ctn" class="col-sm-2 col-form-label">CTN No.</label>
            <div class="col-sm-4"><input id="s_ctn" class="form-control form-control-sm" maxlength="50" /></div>
            <label for="s_part" class="col-sm-2 col-form-label">Part No.</label>
            <div class="col-sm-4"><input id="s_part" class="form-control form-control-sm" maxlength="50" /></div>
        </div>
        <div class="form-group row">
            <label for="s_batch" class="col-sm-2 col-form-label">Batch No.</label>
            <div class="col-sm-4"><input id="s_batch" class="form-control form-control-sm" maxlength="50" /></div>
            <label for="s_slip" class="col-sm-2 col-form-label">Slip No.</label>
            <div class="col-sm-4"><input id="s_slip" class="form-control form-control-sm" maxlength="50" /></div>
        </div>
        <div class="form-group row">
            <label for="s_issuedtfm" class="col-sm-2 col-form-label">Issue Date From</label>
            <div class="col-sm-4"><input id="s_issuedtfm" class="form-control form-control-sm" readonly /></div>
            <label for="s_issuedtto" class="col-sm-2 col-form-label">Issue Date To</label>
            <div class="col-sm-4"><input id="s_issuedtto" class="form-control form-control-sm" readonly /></div>
        </div>
        <div class="form-group row">
            <label for="s_locfm" class="col-sm-2 col-form-label">From Location</label>
            <div class="col-sm-4"><select id="s_locfm" class="form-control form-control-sm"><option value="-1">All</option></select></div>
            <label for="s_locto" class="col-sm-2 col-form-label">To Location</label>
            <div class="col-sm-4"><select id="s_locto" class="form-control form-control-sm"><option value="-1">All</option></select></div>
        </div>
        <div class="form-group row">
            <label for="status_op" class="col-sm-2 col-form-label">Status</label>
            <div class="col-sm-10"><select id="status_op" class="form-control form-control-sm">
                <option value="FAIL">Fail / Error</option><option value="ALL">All</option>
                <option value="SUCCESS">Success</option><option value="EMPTY">No status (NULL / blank)</option>
                <option value="UNKNOWN">Other / Unknown</option>
            </select></div>
        </div>
        <div class="text-right mb-3">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
            <button type="button" id="btnReset" class="btn btn-warning btn-sm">Reset</button>
        </div>
    </fieldset>
</form>
<div class="mb-3">
    <button type="button" id="btnRepost" class="btn btn-primary btn-sm" disabled>Re-post selected CTN</button>
    <span id="selectionCount" class="ml-2">Selected: 0</span>
    <span id="repostProgress" class="ml-2" role="status"></span>
</div>
<div id="reportMessage" role="alert" class="text-danger mb-2"></div>
<div id="reportTableArea" class="table-responsive">
    <table id="dt_ReportRepost" class="table table-striped table-bordered" style="width:100%;font-size:12px">
        <thead style="background-color:cornflowerblue"><tr>
            <th>Select</th><th>Slip No.</th><th>From Loc.</th><th>To Loc.</th><th>CTN</th>
            <th>RFID Cart</th><th>RFID Tag</th><th>Part No.</th><th>Batch</th><th>Qty</th>
            <th>Reason to slip Fifo</th><th>Scan Issue by</th><th>Issue Date/Time</th>
            <th>Actual Bin</th><th>SAP document</th><th>Return Status from Smart</th>
        </tr></thead><tbody></tbody>
    </table>
</div>
<div id="repostResultsArea" class="mt-3" style="display:none">
    <h6>Re-post results</h6>
    <table class="table table-sm table-bordered"><thead><tr><th>Slip</th><th>CTN</th><th>Result</th></tr></thead>
        <tbody id="repostResults"></tbody></table>
</div>
@section scripts {
    <script src="~/Scripts/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script>
        var ReportAndRepostUrls = {
            search: '@Url.Action("Search", "ReportAndRepost")',
            repost: '@Url.Action("Repost", "ReportAndRepost")',
            locations: '@Url.Action("getUserLocation", "GTReport")'
        };
    </script>
    <script src="~/Scripts/Views/ReportAndRepost.js"></script>
}
